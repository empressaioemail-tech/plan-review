{
  "functions": {
    "api/icc-page.js": {
      "includeFiles": "index.html"
    }
  },
  "rewrites": [
    { "source": "/api/backend", "destination": "/api/backend" },
    { "source": "/icc/activity", "destination": "/api/icc-page" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
